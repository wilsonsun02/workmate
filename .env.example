# Workmate runtime environment (copy to .env and fill in values)
# cp .env.example .env

# --- LLM provider ---
LLM_PROVIDER=dashscope
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MINIMAX_DOMAIN=
RUNLOOP_API_KEY=
TEXT_LLM_MODEL=qwen-plus
TEXT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_LLM_MODEL=

# --- Sandbox & subagents ---
USE_SANDBOX=false
ENABLE_SUBAGENTS=true
SUBAGENTS_CONFIG_PATH=config/subagents.json
RUNLOOP_API_KEY=

# --- Template fallback (primary config is via Admin UI) ---
TEMPLATE_DIR=template
IMAGE_TEMPLATE_DIR=template/image-template

# --- Skills & OSS ---
SKILL_INSTALL_TRIGGER_MODE=manual
SKILL_AUTO_UPGRADE_MAX_CONCURRENCY=2
SKILL_AUTO_UPGRADE_RETRY_TIMES=3
SKILL_AUTO_UPGRADE_RETRY_BACKOFF_SEC=5
SKILL_ROLLOUT_DEFAULT_BATCH_SIZE=10
SKILL_ROLLOUT_FAILURE_THRESHOLD=0.2
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_AUTH_MODE=ak
OSS_STS_TOKEN=

# --- MCP access control ---
MCP_READ_ALLOWED_DIRS=${BASE_DIR}
MCP_WRITE_ALLOWED_DIRS=${BASE_DIR}/output,${BASE_DIR}/workspace
MCP_ENABLE_WINDOWS_TOOLS=true
MCP_ENABLE_ADVANCED_TOOLS=true
MCP_ENABLE_COMMON_TOOLS=true
MCP_ENABLE_DOCUMENT_TOOLS=true
MCP_ENABLE_EXECUTION_TOOLS=true
MCP_ENABLE_MEDIA_TOOLS=true
MCP_ENABLE_SEARCH_TOOLS=true
MCP_ENABLE_WECHAT_TOOLS=true
MCP_ENABLE_HAPP_TOOLS=false

# --- Database & cache ---
WORKMATE_DB_HOST=localhost
WORKMATE_DB_DATABASE=workmate_pd
WORKMATE_DB_USER=
WORKMATE_DB_PASS=
REPORT_DB_HOST=
REPORT_DB_PORT=3306
REPORT_DB_USER=
REPORT_DB_PASS=
REPORT_DB_DATABASE=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- WeChat & WeChat Work ---
WECHAT_ATTACHMENT_SAVE_DIR=${BASE_DIR}/tools/wechat_attachments
WECHAT_ATTACHMENT_CACHE_FILE=${BASE_DIR}/tools/config/wechat_attachment_cache.json
WECHAT_AUDIO_CACHE_FILE=${BASE_DIR}/tools/config/wechat_audio_cache.json
WECHAT_WINDOW_TITLE=微信
WECHAT_PROCESS_NAME=WeChat.exe
WECHAT_AI_REPLY_PREFIX=
WECHAT_WORK_CORP_ID=
WECHAT_WORK_AGENT_ID=
WECHAT_WORK_SECRET=
WECHAT_WORK_ALLOWED_USERS=
WXWORK_BOT_ID=
WXWORK_SECRET=
WXWORK_URL=
WXWORK_TOKEN=
WXWORK_ENCODIING_AES_KEY=

# --- Runtime paths & URLs ---
BASE_DIR=
OUTPUT_BASE_DIR=${BASE_DIR}/output
WORKMATE_CLOUD_URL=
WORKMATE_ADMIN_API_BASE=http://127.0.0.1:8010/api/admin
WORKMATE_AGENT_BASE_URL=http://127.0.0.1:8009
WORKMATE_ADMIN_HOST=127.0.0.1
WORKMATE_ADMIN_PORT=8010
WORKMATE_ADMIN_LOG_LEVEL=INFO
WORKMATE_LOG_LEVEL=INFO
WORKMATE_LOG_STDOUT=
AGENT_USERNAME=
WORKMATE_CLIENT_HEARTBEAT_TIMEOUT_SECONDS=90
WORKMATE_CLIENT_AUTH_TIMEOUT_SECONDS=30

# --- Memory ---
MEMORY_SHORT_TERM_TASKS=5
MEMORY_MID_TERM_TASKS=20
MEMORY_ENABLE_TOPIC_SEARCH=true
MEMORY_RELEVANT_TASKS_LIMIT=5
MEMORY_SEARCH_CANDIDATE_LIMIT=50

# --- Optional integrations ---
RICH_AGENT_TOKEN=
CONTRACT_COMPARISON_BASE_URL=http://localhost:8000
REPORT_SHARE_SERVER=\\fileserver.example.com
REPORT_SHARE_PATH=\\fileserver.example.com\reports\output\example
REPORT_SHARE_USER=
REPORT_SHARE_PASSWORD=
